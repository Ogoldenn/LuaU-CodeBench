# Copy to .env and enter your own provider details. Never commit .env.
LUAUBENCH_PROVIDER=custom
LUAUBENCH_BASE_URL=https://YOUR-PROVIDER.example/v1
LUAUBENCH_API_KEY=replace-me
LUAUBENCH_MODEL=model-id
LUAUBENCH_AUTH_HEADER=Authorization
LUAUBENCH_AUTH_PREFIX=Bearer
LUAUBENCH_HTTP_BACKEND=auto
LUAUBENCH_PRIVATE_TESTS_DIR=private-evaluator/tasks
